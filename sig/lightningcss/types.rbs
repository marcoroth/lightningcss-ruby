# Note: This file is hand written, `rbs-inline` does not generate this file.

module LightningCSS
  type version = Integer | Float | String

  type browsers = {
    ?android: version,
    ?chrome: version,
    ?edge: version,
    ?firefox: version,
    ?ie: version,
    ?ios: version,
    ?ios_saf: version,
    ?opera: version,
    ?safari: version,
    ?samsung: version
  }

  type css_modules = bool | {
    ?pattern: String,
    ?dashed_idents: bool,
    ?animation: bool,
    ?grid: bool,
    ?container: bool,
    ?custom_idents: bool,
    ?pure: bool
  }
end
